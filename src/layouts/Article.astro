---
import Base from './Base.astro';
import AuthorBox from '@components/AuthorBox.astro';
import Newsletter from '@components/Newsletter.astro';
import { buildArticleSchema, buildBreadcrumbSchema } from '@utils/seo';
import { UPDATED } from '@data/site';

interface Props {
  title: string;          // balise title (SEO)
  h1: string;
  description: string;
  intro?: string;
  image: string;
  imageAlt: string;
  crumb: string;
  pubDate: Date;
  updatedDate?: Date;
  schema?: object[];
  toc?: { id: string; label: string }[];
  newsletter?: boolean;
}
const { title, h1, description, intro, image, imageAlt, crumb, pubDate, updatedDate = UPDATED, schema = [], toc = [], newsletter = true } = Astro.props;
const path = Astro.url.pathname;
const schemas = [
  buildArticleSchema({ title: h1, description, path, image, pubDate, updatedDate }),
  buildBreadcrumbSchema([{ name: 'Accueil', url: '/' }, { name: crumb, url: path }]),
  ...schema,
];
---
<Base title={title} description={description} ogImage={image} ogImageAlt={imageAlt} type="article" pubDate={pubDate} updatedDate={updatedDate} schema={schemas}>
  <header class="relative overflow-hidden bg-forest text-white">
    <div class="stripes absolute right-0 top-0 h-3.5 w-1/3" aria-hidden="true"></div>
    <div class="wrap grid items-center gap-10 py-12 md:grid-cols-[1.15fr_1fr] md:py-16">
      <div>
        <nav aria-label="Fil d'Ariane" class="mb-5 text-sm text-white/55">
          <a href="/" class="hover:text-orange">Accueil</a> <span aria-hidden="true">/</span> <span>{crumb}</span>
        </nav>
        <h1 class="h-lg text-balance text-white">{h1}</h1>
        {intro && <p class="lead mt-5 !text-white/75 [&_strong]:text-white" set:html={intro} />}
        <div class="mt-6"><AuthorBox compact dark /></div>
      </div>
      <img src={image} alt={imageAlt} width="900" height="680" class="aspect-[4/3] w-full rounded-4xl object-cover shadow-lift ring-4 ring-orange/90 ring-offset-4 ring-offset-forest" fetchpriority="high" />
    </div>
  </header>

  <div class="wrap grid gap-12 py-12 lg:grid-cols-[1fr_16rem]">
    <article class="article min-w-0">
      <slot />
      <AuthorBox />
    </article>
    {toc.length > 0 && (
      <aside class="hidden lg:block">
        <nav aria-label="Sommaire" class="sticky top-28 rounded-3xl bg-white p-5 shadow-card ring-1 ring-ink/5">
          <p class="font-display text-sm font-extrabold uppercase tracking-widest">Sommaire</p>
          <ol class="mt-3 space-y-2 text-[0.92rem]">
            {toc.map((t) => <li><a href={`#${t.id}`} class="text-ink-soft hover:text-orange-dark">{t.label}</a></li>)}
          </ol>
          <a href="/simulateur-fatbike-legal/" class="btn-primary mt-5 w-full !px-4 text-sm">Tester un fatbike</a>
        </nav>
      </aside>
    )}
  </div>
  {newsletter && <Newsletter />}
</Base>
