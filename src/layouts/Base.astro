---
import SEOHead from '@components/seo/SEOHead.astro';
import Header from '@components/layout/Header.astro';
import Footer from '@components/layout/Footer.astro';
import '@styles/global.css';
import type { SEOProps } from '@utils/seo';

interface Props extends SEOProps { schema?: object | object[] }
const props = Astro.props;
---
<!doctype html>
<html lang="fr">
  <head>
    <SEOHead {...props} />
    <script is:inline>
      // Mesure d'audience chargée seulement après consentement (CNIL)
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      window.ttfLoadAnalytics = function () {
        if (window.__ttfLoaded) return; window.__ttfLoaded = true;
        var s = document.createElement('script'); s.async = true; s.src = 'https://www.googletagmanager.com/gtag/js?id=G-XSW0CJQWE3'; document.head.appendChild(s);
        gtag('js', new Date()); gtag('config', 'G-XSW0CJQWE3');
        (function(c,l,a,r,i,t,y){c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);})(window,document,"clarity","script","x3rsrhqi9i");
      };
      try { if (localStorage.getItem('ttf-consent') === 'yes') window.ttfLoadAnalytics(); } catch (e) {}
    </script>
  </head>
  <body>
    <a href="#contenu" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-lg focus:bg-orange focus:px-4 focus:py-2 focus:text-white">Aller au contenu</a>
    <Header />
    <main id="contenu"><slot /></main>
    <Footer />
    <div id="consent" class="fixed inset-x-3 bottom-3 z-[90] mx-auto hidden max-w-xl rounded-3xl bg-white p-5 shadow-lift ring-1 ring-ink/10" role="dialog" aria-label="Cookies de mesure d'audience">
      <p class="text-[0.95rem] text-ink-soft">J'utilise des cookies de mesure d'audience pour savoir quels guides t'aident vraiment. Aucune pub. <a href="/confidentialite/" class="font-semibold text-orange-dark underline">En savoir plus</a></p>
      <div class="mt-4 flex gap-3">
        <button data-consent="yes" class="btn-primary !px-5 !py-2.5 text-sm">Accepter</button>
        <button data-consent="no" class="btn-ghost !px-5 !py-2.5 text-sm">Refuser</button>
      </div>
    </div>
    <script is:inline>
      (function () {
        var box = document.getElementById('consent'), v = null;
        try { v = localStorage.getItem('ttf-consent'); } catch (e) {}
        if (!v) box.classList.remove('hidden');
        box.querySelectorAll('[data-consent]').forEach(function (b) {
          b.addEventListener('click', function () {
            var c = b.getAttribute('data-consent');
            try { localStorage.setItem('ttf-consent', c); } catch (e) {}
            box.classList.add('hidden');
            if (c === 'yes') window.ttfLoadAnalytics();
          });
        });
      })();
    </script>
    <script>
      const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } }), { threshold: 0.12 });
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
      // Suivi des clics affiliés dans Google Analytics
      document.addEventListener('click', (ev) => {
        const a = (ev.target as HTMLElement).closest('a[rel~="sponsored"]') as HTMLAnchorElement | null;
        if (a && (window as any).gtag) (window as any).gtag('event', 'clic_affilie', { lien: a.href, produit: a.dataset.product ?? '' });
      });
    </script>
  </body>
</html>
