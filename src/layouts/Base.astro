---
import SEOHead from '@components/seo/SEOHead.astro';
import Header from '@components/layout/Header.astro';
import Footer from '@components/layout/Footer.astro';
import '@styles/global.css';
import type { SEOProps } from '@utils/seo';

interface Props extends SEOProps {
  path?: string;
  schema?: object | object[];
  fullWidth?: boolean;
}

const { fullWidth = false, ...seoProps } = Astro.props;
---

<!doctype html>
<html lang="fr" class="dark">
  <head>
    <SEOHead {...seoProps} path={Astro.url.pathname} />
    <!-- Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-XSW0CJQWE3"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-XSW0CJQWE3');
    </script>
  </head>
  <body class="min-h-screen bg-brand-black text-brand-gray-100 font-sans">
    <!-- Skip to content (accessibility) -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-[100]
             focus:px-4 focus:py-2 focus:bg-brand-orange focus:text-white focus:rounded-lg focus:text-sm"
    >
      Aller au contenu
    </a>

    <Header />

    <main id="main-content" tabindex="-1">
      <slot />
    </main>

    <Footer />

    <!-- Scroll reveal script -->
    <script>
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add('revealed');
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
      );

      document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
    </script>
  </body>
</html>
