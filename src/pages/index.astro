---
import Base from '@layouts/Base.astro';
import Hero from '@components/sections/Hero.astro';
import TrustStrip from '@components/sections/TrustStrip.astro';
import WhyFatbike from '@components/sections/WhyFatbike.astro';
import CategoryGrid from '@components/sections/CategoryGrid.astro';
import FeaturedProducts from '@components/sections/FeaturedProducts.astro';
import AdventureUniverse from '@components/sections/AdventureUniverse.astro';
import QuizTeaser from '@components/sections/QuizTeaser.astro';
import LatestGuides from '@components/sections/LatestGuides.astro';
import AffiliateBanner from '@components/product/AffiliateBanner.astro';
import FAQ from '@components/sections/FAQ.astro';
import Newsletter from '@components/sections/Newsletter.astro';
import { buildWebsiteSchema, SITE } from '@utils/seo';

// ─── Homepage SEO ───────────────────────────────────────────────────────────
const SEO = {
  title:       undefined, // Homepage uses site default: "TrouveTonFatBike — Explore sans limites."
  description: 'Comparateur et guide d\'achat fatbike électrique N°1 en France. Trouve le meilleur fatbike électrique selon ton terrain, ton budget et ton usage. Comparatifs 2026, avis experts et quiz personnalisé.',
  tags:        ['fatbike électrique', 'meilleur fatbike', 'comparatif fatbike', 'guide achat fatbike', 'fatbike 2026', 'fatbike prix'],
  ogImage:     '/og-default.jpg',
};

// Homepage specific schema
const localBusinessSchema = {
  '@context':  'https://schema.org',
  '@type':     'WebPage',
  name:        SITE.name,
  description: SEO.description,
  url:         SITE.url,
  inLanguage:  'fr-FR',
  about: {
    '@type': 'Thing',
    name:    'Fatbike électrique',
  },
  mainEntity: {
    '@type': 'ItemList',
    name:    'Meilleures catégories fatbike 2026',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Fatbike Montagne', url: `${SITE.url}/categorie/fatbike-montagne/` },
      { '@type': 'ListItem', position: 2, name: 'Fatbike Plage',    url: `${SITE.url}/categorie/fatbike-plage/` },
      { '@type': 'ListItem', position: 3, name: 'Fatbike Neige',    url: `${SITE.url}/categorie/fatbike-neige/` },
      { '@type': 'ListItem', position: 4, name: 'Fatbike Urbain',   url: `${SITE.url}/categorie/fatbike-urbain/` },
      { '@type': 'ListItem', position: 5, name: 'Cani-Fatbike',     url: `${SITE.url}/cani-fatbike/` },
    ],
  },
};
---

<Base
  {...SEO}
  type="website"
  schema={localBusinessSchema}
>

  <!-- ═══════════════════════════════════════════════════════════
       1. HERO — Cinématique, immersif, plein écran
  ════════════════════════════════════════════════════════════ -->
  <Hero />
  <hr class="orange-rule" />

  <!-- ═══════════════════════════════════════════════════════════
       2. TRUST STRIP — fond légèrement plus clair
  ════════════════════════════════════════════════════════════ -->
  <div class="section-alt">
    <TrustStrip />
  </div>

  <!-- ═══════════════════════════════════════════════════════════
       3. CATÉGORIES — fond noir pur
  ════════════════════════════════════════════════════════════ -->
  <CategoryGrid />
  <hr class="orange-rule" />

  <!-- ═══════════════════════════════════════════════════════════
       4. POURQUOI FATBIKE — fond alt
  ════════════════════════════════════════════════════════════ -->
  <div class="section-alt">
    <WhyFatbike />
  </div>

  <!-- ═══════════════════════════════════════════════════════════
       5. MEILLEURS MODÈLES — fond noir
  ════════════════════════════════════════════════════════════ -->
  <FeaturedProducts />

  <!-- ═══════════════════════════════════════════════════════════
       6. GALERIE LIFESTYLE — scroll horizontal
       → Ajouter vos photos dans /public/images/lifestyle-*.jpg
  ════════════════════════════════════════════════════════════ -->
  <section class="section-alt py-16 md:py-20 overflow-hidden" aria-label="L'univers fatbike en images">
    <div class="container-site mb-8 md:mb-10">
      <div class="section-label">Univers fatbike</div>
      <h2 class="heading-h2 mt-3">
        Rouler partout,
        <span class="text-gradient-orange">explorer sans limites</span>
      </h2>
    </div>
    <div class="flex gap-4 overflow-x-auto scrollbar-hide pl-5 sm:pl-8 md:pl-12 lg:pl-16 pr-5 pb-3">

      <a href="/categorie/fatbike-montagne/"
         class="relative flex-shrink-0 w-56 sm:w-72 h-80 rounded-2xl overflow-hidden border border-brand-gray-700
                bg-gradient-to-b from-slate-700 to-brand-gray-900 group">
        <img src="/images/lifestyle-montagne.jpg" alt="Fatbike en montagne"
             class="absolute inset-0 w-full h-full object-cover opacity-80 group-hover:opacity-100 group-hover:scale-105 transition-all duration-500"
             loading="lazy" />
        <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
        <div class="absolute bottom-0 left-0 right-0 p-5">
          <span class="text-brand-orange text-2xs font-semibold uppercase tracking-widest">Terrain</span>
          <p class="font-display font-bold text-xl text-white mt-1">Montagne</p>
        </div>
      </a>

      <a href="/categorie/fatbike-plage/"
         class="relative flex-shrink-0 w-56 sm:w-72 h-80 rounded-2xl overflow-hidden border border-brand-gray-700
                bg-gradient-to-b from-blue-900 to-brand-gray-900 group">
        <img src="/images/lifestyle-plage.jpg" alt="Fatbike sur la plage"
             class="absolute inset-0 w-full h-full object-cover opacity-80 group-hover:opacity-100 group-hover:scale-105 transition-all duration-500"
             loading="lazy" />
        <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
        <div class="absolute bottom-0 left-0 right-0 p-5">
          <span class="text-brand-orange text-2xs font-semibold uppercase tracking-widest">Terrain</span>
          <p class="font-display font-bold text-xl text-white mt-1">Plage</p>
        </div>
      </a>

      <a href="/categorie/fatbike-neige/"
         class="relative flex-shrink-0 w-56 sm:w-72 h-80 rounded-2xl overflow-hidden border border-brand-gray-700
                bg-gradient-to-b from-sky-900 to-brand-gray-900 group">
        <img src="/images/lifestyle-neige.jpg" alt="Fatbike dans la neige"
             class="absolute inset-0 w-full h-full object-cover opacity-80 group-hover:opacity-100 group-hover:scale-105 transition-all duration-500"
             loading="lazy" />
        <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
        <div class="absolute bottom-0 left-0 right-0 p-5">
          <span class="text-brand-orange text-2xs font-semibold uppercase tracking-widest">Terrain</span>
          <p class="font-display font-bold text-xl text-white mt-1">Neige</p>
        </div>
      </a>

      <a href="/cani-fatbike/"
         class="relative flex-shrink-0 w-56 sm:w-72 h-80 rounded-2xl overflow-hidden border border-brand-gray-700
                bg-gradient-to-b from-emerald-900 to-brand-gray-900 group">
        <img src="/images/lifestyle-canicross.jpg" alt="Cani-fatbike"
             class="absolute inset-0 w-full h-full object-cover opacity-80 group-hover:opacity-100 group-hover:scale-105 transition-all duration-500"
             loading="lazy" />
        <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
        <div class="absolute bottom-0 left-0 right-0 p-5">
          <span class="text-brand-orange text-2xs font-semibold uppercase tracking-widest">Sport</span>
          <p class="font-display font-bold text-xl text-white mt-1">Cani-fatbike</p>
        </div>
      </a>

      <a href="/categorie/fatbike-urbain/"
         class="relative flex-shrink-0 w-56 sm:w-72 h-80 rounded-2xl overflow-hidden border border-brand-gray-700
                bg-gradient-to-b from-zinc-700 to-brand-gray-900 group">
        <img src="/images/lifestyle-urbain.jpg" alt="Fatbike en ville"
             class="absolute inset-0 w-full h-full object-cover opacity-80 group-hover:opacity-100 group-hover:scale-105 transition-all duration-500"
             loading="lazy" />
        <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
        <div class="absolute bottom-0 left-0 right-0 p-5">
          <span class="text-brand-orange text-2xs font-semibold uppercase tracking-widest">Terrain</span>
          <p class="font-display font-bold text-xl text-white mt-1">Urbain</p>
        </div>
      </a>

    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════
       7. AFFILIATE BANNER — CTA Amazon élégant
  ════════════════════════════════════════════════════════════ -->
  <section class="section-padding-sm" aria-label="Offres du moment">
    <div class="container-site">
      <AffiliateBanner variant="amazon" />
    </div>
  </section>
  <hr class="orange-rule" />

  <!-- ═══════════════════════════════════════════════════════════
       8. UNIVERS AVENTURE — fond alt
  ════════════════════════════════════════════════════════════ -->
  <div class="section-alt">
    <AdventureUniverse />
  </div>

  <!-- ═══════════════════════════════════════════════════════════
       9. QUIZ TEASER — fond noir
  ════════════════════════════════════════════════════════════ -->
  <QuizTeaser />
  <hr class="orange-rule" />

  <!-- ═══════════════════════════════════════════════════════════
       10. GUIDES — fond alt
  ════════════════════════════════════════════════════════════ -->
  <div class="section-alt">
    <LatestGuides />
  </div>

  <!-- ═══════════════════════════════════════════════════════════
       11. AFFILIATE GUIDE BANNER
  ════════════════════════════════════════════════════════════ -->
  <section class="section-padding-sm" aria-label="Guide complet 2026">
    <div class="container-site">
      <AffiliateBanner variant="guide" />
    </div>
  </section>
  <hr class="orange-rule" />

  <!-- ═══════════════════════════════════════════════════════════
       12. FAQ SEO — fond alt
  ════════════════════════════════════════════════════════════ -->
  <div class="section-alt">
    <FAQ />
  </div>

  <!-- ═══════════════════════════════════════════════════════════
       13. NEWSLETTER — fond noir
  ════════════════════════════════════════════════════════════ -->
  <Newsletter />

</Base>
