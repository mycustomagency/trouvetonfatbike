---
import Base from '@layouts/Base.astro';
import { CATEGORIES } from '@data/categories';

const sorted = [...CATEGORIES].sort((a, b) => a.sortOrder - b.sortOrder);
---

<Base
  title="Toutes les catégories de fatbike électrique"
  description="Explorez toutes nos catégories de fatbike électrique : montagne, plage, neige, urbain, débutant, budget et plus. Trouvez la catégorie parfaite pour votre usage."
>

  <!-- Header -->
  <section class="section-padding-sm border-b border-brand-gray-800">
    <div class="container-site">
      <nav aria-label="Fil d'Ariane" class="mb-6">
        <ol class="flex items-center gap-2 text-xs text-brand-gray-400" role="list">
          <li><a href="/" class="hover:text-brand-orange transition-colors">Accueil</a></li>
          <li><span aria-hidden="true">/</span></li>
          <li class="text-brand-gray-200">Catégories</li>
        </ol>
      </nav>
      <div class="section-label mb-4">Toutes les catégories</div>
      <h1 class="heading-h1 mb-4">Fatbikes par usage & terrain</h1>
      <p class="text-brand-gray-300 text-lg max-w-xl text-pretty">
        Chaque terrain, chaque usage mérite le bon fatbike. Explore nos catégories pour trouver ta sélection personnalisée.
      </p>
    </div>
  </section>

  <!-- Grid -->
  <section class="section-padding">
    <div class="container-site">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {sorted.map((cat, i) => (
          <a
            href={`/categorie/${cat.slug}/`}
            class="card-base card-hover group flex flex-col overflow-hidden reveal"
            style={`animation-delay: ${i * 0.06}s`}
          >
            {/* Image */}
            <div class="h-44 overflow-hidden bg-brand-gray-800 flex-shrink-0 relative">
              <img
                src={cat.coverImage}
                alt={cat.title}
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                loading="lazy"
                decoding="async"
                width="600" height="300"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-brand-gray-900/70 to-transparent"></div>
              <div class="absolute top-3 left-3 text-2xl" aria-hidden="true">{cat.icon}</div>
            </div>

            {/* Content */}
            <div class="p-5 flex flex-col flex-1">
              <h2 class="font-display font-semibold text-brand-offwhite text-base mb-1
                         group-hover:text-brand-orange transition-colors duration-200">
                {cat.title}
              </h2>
              <p class="text-xs text-brand-gray-400 mb-4 leading-relaxed flex-1">
                {cat.terrain}
              </p>
              <div class="flex items-center justify-between">
                <span class="font-mono text-xs text-brand-orange">
                  {cat.budgetMin.toLocaleString('fr-FR')}€ – {cat.budgetMax.toLocaleString('fr-FR')}€
                </span>
                <span class="text-xs text-brand-gray-500 group-hover:text-brand-orange transition-colors flex items-center gap-1">
                  Voir
                  <svg class="w-3.5 h-3.5" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                    <path d="M3 7h8M7 3l4 4-4 4" stroke="currentColor" stroke-width="1.25" stroke-linecap="round"/>
                  </svg>
                </span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

</Base>
