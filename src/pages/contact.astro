---
import Base from '@layouts/Base.astro';
---

<Base
  title="Contact — TrouveTonFatBike"
  description="Une question sur un fatbike, un partenariat ou une suggestion ? Contactez l'équipe TrouveTonFatBike."
  noIndex={true}
>
  <section class="section-padding">
    <div class="container-narrow max-w-2xl">

      <!-- Header -->
      <div class="mb-10">
        <div class="section-label mb-3">Contact</div>
        <h1 class="heading-h2 mb-4">On est là pour toi</h1>
        <p class="text-brand-gray-300 text-lg leading-relaxed">
          Une question sur un fatbike ? Un partenariat ? Écris-nous !
        </p>
      </div>

      <!-- Cards info -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-10">
        {[
          { emoji: '❓', title: 'Question produit',   desc: 'Aide au choix, comparatif, conseil technique' },
          { emoji: '🤝', title: 'Partenariat',        desc: 'Marques, revendeurs, collaborations' },
          { emoji: '💡', title: 'Suggestion',         desc: 'Idée de guide, retour d\'expérience' },
        ].map(card => (
          <div class="bg-brand-gray-900 rounded-xl p-4 border border-brand-gray-800 text-center">
            <span class="text-2xl block mb-2" aria-hidden="true">{card.emoji}</span>
            <p class="text-sm font-semibold text-brand-gray-100 mb-1">{card.title}</p>
            <p class="text-xs text-brand-gray-400 leading-snug">{card.desc}</p>
          </div>
        ))}
      </div>

      <!-- Form card -->
      <div class="card-glass p-6 md:p-8">
        <form id="contact-form" novalidate>

          <div class="flex flex-col gap-5">

            <!-- Nom -->
            <div>
              <label for="contact-name" class="block text-sm font-medium text-brand-gray-200 mb-2">
                Nom <span class="text-brand-orange" aria-hidden="true">*</span>
              </label>
              <input
                id="contact-name"
                type="text"
                name="name"
                placeholder="Ton prénom ou nom"
                required
                autocomplete="name"
                class="input-base w-full"
              />
            </div>

            <!-- Email -->
            <div>
              <label for="contact-email" class="block text-sm font-medium text-brand-gray-200 mb-2">
                Email <span class="text-brand-orange" aria-hidden="true">*</span>
              </label>
              <input
                id="contact-email"
                type="email"
                name="email"
                placeholder="ton@email.com"
                required
                autocomplete="email"
                class="input-base w-full"
              />
            </div>

            <!-- Sujet -->
            <div>
              <label for="contact-subject" class="block text-sm font-medium text-brand-gray-200 mb-2">
                Sujet
              </label>
              <select id="contact-subject" name="subject" class="input-base w-full">
                <option value="">Choisir un sujet…</option>
                <option value="question-produit">Question sur un fatbike</option>
                <option value="partenariat">Partenariat / collaboration</option>
                <option value="suggestion">Suggestion de contenu</option>
                <option value="autre">Autre</option>
              </select>
            </div>

            <!-- Message -->
            <div>
              <label for="contact-message" class="block text-sm font-medium text-brand-gray-200 mb-2">
                Message <span class="text-brand-orange" aria-hidden="true">*</span>
              </label>
              <textarea
                id="contact-message"
                name="message"
                rows="5"
                placeholder="Décris ta question ou ta demande…"
                required
                class="input-base w-full resize-none"
              ></textarea>
            </div>

          </div>

          <!-- Submit -->
          <div class="mt-6">
            <button type="submit" id="contact-submit" class="btn-primary btn-md w-full justify-center">
              Envoyer le message
              <svg class="w-4 h-4" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M2 8h12M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
            <p class="text-xs text-brand-gray-500 text-center mt-3">
              Ouvre ton client email avec le message pré-rempli · Réponse sous 48 h
            </p>
          </div>

          <!-- Status -->
          <p id="contact-status" class="text-sm text-center mt-4 hidden" aria-live="polite"></p>

        </form>
      </div>

      <!-- Direct email fallback -->
      <div class="mt-6 text-center">
        <p class="text-sm text-brand-gray-400">
          Tu préfères écrire directement ?
          <a href="mailto:contact@trouvetonfatbike.com" class="text-brand-orange hover:underline ml-1 font-medium">
            contact@trouvetonfatbike.com
          </a>
        </p>
      </div>

      <div class="mt-10 pt-8 divider">
        <a href="/" class="text-sm text-brand-gray-400 hover:text-brand-orange transition-colors">
          ← Retour à l'accueil
        </a>
      </div>

    </div>
  </section>
</Base>

<script>
  const form     = document.getElementById('contact-form') as HTMLFormElement;
  const statusEl = document.getElementById('contact-status') as HTMLParagraphElement;
  const submitBtn = document.getElementById('contact-submit') as HTMLButtonElement;

  form?.addEventListener('submit', (e) => {
    e.preventDefault();

    const name    = (form.querySelector('#contact-name')    as HTMLInputElement).value.trim();
    const email   = (form.querySelector('#contact-email')   as HTMLInputElement).value.trim();
    const subject = (form.querySelector('#contact-subject') as HTMLSelectElement).value;
    const message = (form.querySelector('#contact-message') as HTMLTextAreaElement).value.trim();

    if (!name || !email || !message) {
      statusEl.textContent = 'Merci de remplir les champs obligatoires.';
      statusEl.style.color = '#f87171';
      statusEl.classList.remove('hidden');
      return;
    }

    const subjectLabels: Record<string, string> = {
      'question-produit': 'Question sur un fatbike',
      'partenariat':      'Partenariat / collaboration',
      'suggestion':       'Suggestion de contenu',
      'autre':            'Autre',
    };

    const subjectLine = subject ? subjectLabels[subject] ?? subject : 'Contact TrouveTonFatBike';
    const body = `Nom : ${name}\nEmail : ${email}\n\n${message}`;

    const mailto = `mailto:contact@trouvetonfatbike.com?subject=${encodeURIComponent(subjectLine)}&body=${encodeURIComponent(body)}`;
    window.location.href = mailto;

    submitBtn.disabled = true;
    submitBtn.textContent = 'Message préparé ✓';
    statusEl.textContent = 'Ton client email va s\'ouvrir avec le message pré-rempli.';
    statusEl.style.color = '#4ade80';
    statusEl.classList.remove('hidden');
  });
</script>
