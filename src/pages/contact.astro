---
import Prose from '@layouts/Prose.astro';
---
<Prose title="Contact" h1="Me contacter" description="Une question sur un fatbike, un partenariat ou une erreur à signaler ? Contacte TrouveTonFatbike." eyebrow="Contact">
  <p>Une question sur un fatbike, une erreur repérée, une idée de guide ou une proposition de test ? Écris-moi, je réponds en général sous 48 heures.</p>
  <form id="contact" class="not-prose card mt-8 space-y-4 p-6">
    <div><label for="c-name" class="mb-1 block font-semibold">Ton prénom</label><input id="c-name" class="field" required autocomplete="given-name" /></div>
    <div><label for="c-subject" class="mb-1 block font-semibold">Sujet</label>
      <select id="c-subject" class="field"><option>Question sur un fatbike</option><option>Partenariat ou test produit</option><option>Erreur à signaler</option><option>Autre</option></select></div>
    <div><label for="c-msg" class="mb-1 block font-semibold">Message</label><textarea id="c-msg" rows="6" class="field" required></textarea></div>
    <button class="btn-primary w-full">Écrire mon email</button>
    <p class="text-center text-sm text-ink-mute">Ton logiciel de messagerie s'ouvre avec le message pré-rempli.</p>
  </form>
  <p class="mt-8">Tu préfères écrire directement ? <a href="mailto:contact@trouvetonfatbike.com">contact@trouvetonfatbike.com</a></p>
  <script>
    document.getElementById('contact')?.addEventListener('submit', (e) => {
      e.preventDefault();
      const v = (id: string) => (document.getElementById(id) as HTMLInputElement).value;
      location.href = `mailto:contact@trouvetonfatbike.com?subject=${encodeURIComponent(v('c-subject') + ' (' + v('c-name') + ')')}&body=${encodeURIComponent(v('c-msg'))}`;
    });
  </script>
</Prose>
