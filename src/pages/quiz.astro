---
import Base from '@layouts/Base.astro';
import Newsletter from '@components/Newsletter.astro';
import { BIKES } from '@data/bikes';

const data = BIKES.map((b) => ({ id: b.id, name: b.name, price: b.priceFrom, usages: b.usages, dog: b.dogFriendly, bestFor: b.bestFor, href: b.href, weight: b.weight, wheels: b.wheels, tested: !!b.tested }));
const qs = [
  { id: 'use', q: 'Tu rouleras surtout…', o: [['ville', 'En ville et sur piste cyclable'], ['chemins', 'Sur les chemins et en forêt'], ['plage-neige', 'Dans le sable ou la neige'], ['chien', 'En balade avec mon chien']] },
  { id: 'fold', q: 'Tu dois le ranger dans un coffre, un appart ou un camping-car ?', o: [['oui', 'Oui, il doit se plier'], ['non', 'Non, j\'ai un garage ou un local']] },
  { id: 'budget', q: 'Ton budget maximum ?', o: [['1000', 'Moins de 1 000 €'], ['1500', 'Jusqu\'à 1 500 €'], ['2500', 'Jusqu\'à 2 500 €'], ['9999', 'Pas de limite']] },
  { id: 'prio', q: 'Ce qui compte le plus pour toi ?', o: [['prix', 'Le meilleur prix'], ['confort', 'Le confort'], ['style', 'Le look'], ['leger', 'Un vélo pas trop lourd']] },
];
---
<Base title="Quel fatbike électrique choisir ? Le quiz en 1 minute" description="Réponds à 4 questions et découvre le fatbike électrique légal (250 W, 25 km/h) qui correspond à ton usage, ton budget et ton rangement.">
  <section class="bg-sand">
    <div class="wrap-prose py-14 text-center md:py-20">
      <p class="eyebrow justify-center">Quiz · 1 minute</p>
      <h1 class="h-lg mt-4">Quel fatbike électrique est fait pour toi ?</h1>
      <p class="lead mt-4">4 questions, et je te propose les modèles légaux qui collent à ta vie.</p>
    </div>
  </section>
  <section class="wrap-prose -mt-6">
    <form id="quiz" class="card space-y-8 p-6 md:p-10">
      {qs.map((q, i) => (
        <fieldset>
          <legend class="font-display text-xl font-extrabold"><span class="mr-2 text-orange">{i + 1}.</span>{q.q}</legend>
          <div class="mt-4 grid gap-2.5 sm:grid-cols-2">
            {q.o.map(([v, l]) => (
              <label class="flex cursor-pointer items-center gap-3 rounded-2xl border-2 border-ink/10 px-4 py-3 transition hover:border-orange/60 has-[:checked]:border-orange has-[:checked]:bg-orange-soft">
                <input type="radio" name={q.id} value={v} class="h-4 w-4 accent-orange" required /><span class="font-medium">{l}</span>
              </label>
            ))}
          </div>
        </fieldset>
      ))}
      <button class="btn-primary w-full text-base">Voir mes fatbikes</button>
      <p id="q-err" class="hidden text-center text-sm font-semibold text-bad" role="alert">Réponds aux 4 questions.</p>
    </form>
    <div id="q-out" class="mt-8 hidden scroll-mt-28 space-y-4" aria-live="polite"></div>
  </section>
  <Newsletter />
</Base>
<script define:vars={{ data }}>
  const f = document.getElementById('quiz');
  const out = document.getElementById('q-out');
  f.addEventListener('submit', (e) => {
    e.preventDefault();
    const a = Object.fromEntries(new FormData(f));
    if (['use', 'fold', 'budget', 'prio'].some((k) => !a[k])) { document.getElementById('q-err').classList.remove('hidden'); return; }
    document.getElementById('q-err').classList.add('hidden');
    const max = Number(a.budget);
    const scored = data.map((b) => {
      let s = 0;
      if (b.usages.includes(a.use)) s += 4;
      if (a.use === 'chien') s += b.dog * 2;
      if (a.fold === 'oui') s += b.usages.includes('pliant') ? 5 : -6;
      if (b.price <= max) s += 3; else s -= 8;
      if (a.prio === 'prix') s += Math.max(0, 3 - Math.floor(b.price / 600));
      if (a.prio === 'style' && b.usages.includes('style')) s += 4;
      if (a.prio === 'confort' && (b.dog === 3)) s += 3;
      if (a.prio === 'leger') { const kg = parseInt((b.weight.match(/\d+/) || ['32'])[0]); s += kg <= 27 ? 4 : kg <= 30 ? 2 : 0; }
      return { ...b, s };
    }).sort((x, y) => y.s - x.s).slice(0, 3);
    out.innerHTML = '<h2 class="font-display text-3xl font-black">Mes 3 suggestions pour toi</h2>' + scored.map((b, i) => `
      <div class="card flex flex-col gap-4 p-6 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <p class="text-xs font-bold uppercase tracking-wider text-orange-dark">${i === 0 ? 'Le plus adapté' : 'Alternative'}${b.tested ? ' · ★ mon vélo' : ''}</p>
          <p class="font-display text-2xl font-black">${b.name}</p>
          <p class="text-ink-soft">${b.bestFor}. Roues ${b.wheels}, ${b.weight}.</p>
          <p class="mt-1 text-sm text-ink-mute">Dès ${b.price.toLocaleString('fr-FR')} € · ✓ 250 W, 25 km/h</p>
        </div>
        <div class="flex shrink-0 flex-col gap-2">
          <a href="${b.href}" rel="sponsored nofollow noopener" target="_blank" data-product="${b.id}" class="btn-primary">Voir le prix</a>
          <a href="/guide/meilleur-fatbike-electrique-2026/#${b.id}" class="text-center text-sm font-bold text-orange-dark hover:underline">Lire l'avis</a>
        </div>
      </div>`).join('');
    out.classList.remove('hidden');
    out.scrollIntoView({ behavior: 'smooth' });
    window.gtag && gtag('event', 'quiz_termine', { usage: a.use, budget: a.budget });
  });
</script>
