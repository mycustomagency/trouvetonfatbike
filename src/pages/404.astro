---
import Base from '@layouts/Base.astro';
const links = [
  ['Comparatif 2026', '/guide/meilleur-fatbike-electrique-2026/'], ['Mon fatbike est-il légal ?', '/simulateur-fatbike-legal/'],
  ['Petit budget', '/guide/fatbike-electrique-pas-cher/'], ['Fatbike & chien', '/cani-fatbike/'], ['Accessoires', '/accessoires/'],
];
---
<Base title="Page introuvable" description="Cette page n'existe pas ou a été déplacée." noIndex>
  <section class="wrap-prose py-24 text-center">
    <p class="font-display text-7xl font-black text-orange">404</p>
    <h1 class="h-lg mt-4">Ce chemin ne mène nulle part</h1>
    <p class="lead mt-4">La page a été déplacée ou n'existe plus. Reprends la route par ici :</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">{links.map(([l, h]) => <a href={h} class="btn-ghost">{l}</a>)}</div>
  </section>
</Base>
