---
import Logo from './Logo.astro';
import { SOCIAL } from '@data/site';
const cols = [
  { title: 'Bien choisir', links: [
    ['Comparatif fatbikes 2026', '/guide/meilleur-fatbike-electrique-2026/'],
    ['Fatbike pas cher et légal', '/guide/fatbike-electrique-pas-cher/'],
    ['Guide d\'achat complet', '/guide/guide-achat-fatbike/'],
    ['Quiz : quel fatbike pour moi ?', '/quiz/'],
    ['Mon Colorway BK29', '/guide/avis-colorway-bk29/'],
  ]},
  { title: 'Rouler légal', links: [
    ['Simulateur « Mon fatbike est-il légal ? »', '/simulateur-fatbike-legal/'],
    ['Réglementation fatbike 2026', '/guide/reglementation-vae-france/'],
    ['Checklist avant d\'acheter', '/checklist-fatbike-legal/'],
  ]},
  { title: 'Fatbike & chien', links: [
    ['Rouler avec son chien', '/cani-fatbike/'],
    ['Remorque chien pour vélo électrique', '/cani-fatbike/remorque-chien-velo-electrique/'],
    ['Accessoires', '/accessoires/'],
  ]},
];
const socials = Object.entries(SOCIAL).filter(([, v]) => v) as [string, string][];
---
<footer class="mt-24 bg-forest-dark text-white/80">
  <div class="wrap grid gap-12 py-16 md:grid-cols-[1.3fr_1fr_1fr_1fr]">
    <div>
      <Logo light />
      <p class="mt-5 max-w-xs text-[0.95rem] leading-relaxed text-white/70">
        Le guide indépendant du fatbike électrique <strong class="text-white">légal</strong>, testé sur les chemins avec mes chiens.
      </p>
      {socials.length > 0 && (
        <ul class="mt-6 flex gap-3">
          {socials.map(([k, v]) => <li><a href={v} class="capitalize text-sm font-semibold text-white hover:text-orange-light" rel="noopener" target="_blank">{k}</a></li>)}
        </ul>
      )}
    </div>
    {cols.map((c) => (
      <div>
        <p class="font-display text-sm font-extrabold uppercase tracking-widest text-white">{c.title}</p>
        <ul class="mt-4 space-y-2.5 text-[0.95rem]">
          {c.links.map(([l, h]) => <li><a href={h} class="hover:text-orange-light">{l}</a></li>)}
        </ul>
      </div>
    ))}
  </div>
  <div class="border-t border-white/10">
    <div class="wrap flex flex-col gap-4 py-6 text-sm text-white/60 md:flex-row md:items-center md:justify-between">
      <p>
        Certains liens sont affiliés : si tu achètes, je touche une petite commission, sans surcoût pour toi.
        En tant que Partenaire Amazon, je réalise un bénéfice sur les achats remplissant les conditions requises.
      </p>
      <ul class="flex flex-wrap gap-x-5 gap-y-2">
        <li><a href="/a-propos/" class="hover:text-white">À propos</a></li>
        <li><a href="/affiliation/" class="hover:text-white">Affiliation</a></li>
        <li><a href="/mentions-legales/" class="hover:text-white">Mentions légales</a></li>
        <li><a href="/confidentialite/" class="hover:text-white">Confidentialité</a></li>
        <li><a href="/contact/" class="hover:text-white">Contact</a></li>
      </ul>
    </div>
  </div>
</footer>
