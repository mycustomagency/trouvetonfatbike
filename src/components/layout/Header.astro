---
import Logo from './Logo.astro';
import { NAV } from '@data/site';
const path = Astro.url.pathname;
---
<header id="top" class="sticky top-0 z-50 bg-forest/95 text-white backdrop-blur-md">
  <div class="wrap flex h-[4.25rem] items-center justify-between gap-4">
    <Logo light />
    <nav aria-label="Navigation principale" class="hidden lg:block">
      <ul class="flex items-center gap-1">
        {NAV.map((l) => (
          <li>
            <a href={l.href}
               class:list={['rounded-full px-3.5 py-2 text-[0.92rem] font-semibold hover:bg-white/10', path.startsWith(l.href) ? 'text-orange' : 'text-white/85']}
               aria-current={path.startsWith(l.href) ? 'page' : undefined}>{l.label}</a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="flex items-center gap-2">
      <a href="/quiz/" class="btn-primary hidden !px-5 !py-2.5 text-sm sm:inline-flex">Quel fatbike pour moi ?</a>
      <button id="nav-toggle" class="grid h-11 w-11 place-items-center rounded-full border-2 border-white/20 lg:hidden" aria-expanded="false" aria-controls="mobile-nav" aria-label="Ouvrir le menu">
        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h10"/></svg>
      </button>
    </div>
  </div>
  <nav id="mobile-nav" class="hidden border-t border-white/10 bg-forest lg:hidden" aria-label="Menu mobile">
    <ul class="wrap flex flex-col py-3">
      {NAV.map((l) => <li><a href={l.href} class="block rounded-xl px-3 py-3 font-semibold text-white hover:bg-white/10">{l.label}</a></li>)}
      <li><a href="/quiz/" class="btn-primary mt-2 w-full">Quel fatbike pour moi ?</a></li>
    </ul>
  </nav>
</header>
<script>
  const t = document.getElementById('nav-toggle');
  const m = document.getElementById('mobile-nav');
  t?.addEventListener('click', () => {
    const open = m?.classList.toggle('hidden') === false;
    t.setAttribute('aria-expanded', String(open));
  });
</script>
