---
import { amazonLink } from '@utils/affiliate';

interface Props {
  name:         string;
  brand:        string;
  asin?:        string;
  href?:        string;
  price?:       number;
  priceOld?:    number;
  image:        string;
  rating?:      number;
  reviewCount?: number;
  badge?:       string;
  badgeType?:   'best' | 'deal' | 'new' | 'editor' | 'budget';
  features?:    string[];
  motor?:       string;
  battery?:     string;
  autonomy?:    string;
  weight?:      string;
  pros?:        string[];
}

const {
  name, brand, asin, href,
  price, priceOld,
  image,
  rating = 0, reviewCount = 0,
  badge, badgeType = 'best',
  features = [],
  motor, battery, autonomy, weight,
  pros = [],
} = Astro.props;

const affiliateUrl = asin ? amazonLink(asin) : href ?? '#';
const discount = priceOld && price ? Math.round(((priceOld - price) / priceOld) * 100) : 0;

const badgeColors = {
  best:   'bg-brand-orange/15 text-brand-orange border-brand-orange/25',
  deal:   'bg-emerald-500/15 text-emerald-400 border-emerald-500/25',
  new:    'bg-blue-500/15 text-blue-400 border-blue-500/25',
  editor: 'bg-purple-500/15 text-purple-400 border-purple-500/25',
  budget: 'bg-yellow-500/15 text-yellow-400 border-yellow-500/25',
};

const stars = Array.from({ length: 5 }, (_, i) => i < Math.floor(rating));
---

<article class="card-base card-hover flex flex-col group" aria-label={`${brand} ${name}`}>

  <!-- ─── Image ──────────────────────────────────────────────────── -->
  <div class="relative overflow-hidden bg-brand-gray-800 rounded-t-2xl aspect-card flex-shrink-0">
    <img
      src={image}
      alt={`${brand} ${name} — fatbike électrique`}
      class="w-full h-full object-cover object-center
             transition-transform duration-500 ease-out group-hover:scale-105"
      loading="lazy"
      decoding="async"
      width="400"
      height="300"
    />

    <!-- Badge -->
    {badge && (
      <div class="absolute top-3 left-3">
        <span class:list={['badge border', badgeColors[badgeType]]}>
          {badgeType === 'best' && (
            <svg class="w-3 h-3" viewBox="0 0 12 12" fill="currentColor" aria-hidden="true">
              <path d="M6 1l1.2 3.6H11L8.1 6.9l1 3.6L6 8.6 2.9 10.5l1-3.6L1 4.6h3.8z"/>
            </svg>
          )}
          {badge}
        </span>
      </div>
    )}

    <!-- Discount badge -->
    {discount > 0 && (
      <div class="absolute top-3 right-3">
        <span class="badge badge-green border border-emerald-500/25">
          -{discount}%
        </span>
      </div>
    )}
  </div>

  <!-- ─── Content ───────────────────────────────────────────────── -->
  <div class="flex flex-col flex-1 p-5">

    <!-- Brand + Name -->
    <div class="mb-3">
      <span class="text-xs font-medium text-brand-orange uppercase tracking-wide mb-1 block">
        {brand}
      </span>
      <h3 class="font-display font-semibold text-brand-offwhite text-base leading-snug line-clamp-2
                 group-hover:text-brand-orange transition-colors duration-200">
        {name}
      </h3>
    </div>

    <!-- Rating -->
    {rating > 0 && (
      <div class="flex items-center gap-2 mb-3">
        <div class="flex items-center gap-0.5" aria-label={`Note: ${rating} sur 5`}>
          {stars.map(filled => (
            <svg
              class:list={['w-3.5 h-3.5', filled ? 'text-yellow-400' : 'text-brand-gray-600']}
              viewBox="0 0 12 12" fill="currentColor" aria-hidden="true"
            >
              <path d="M6 1l1.2 3.6H11L8.1 6.9l1 3.6L6 8.6 2.9 10.5l1-3.6L1 4.6h3.8z"/>
            </svg>
          ))}
        </div>
        <span class="text-xs text-brand-gray-400">
          {rating.toFixed(1)} ({reviewCount.toLocaleString('fr-FR')} avis)
        </span>
      </div>
    )}

    <!-- Specs grid -->
    {(motor || battery || autonomy || weight) && (
      <div class="grid grid-cols-2 gap-2 mb-4">
        {motor && (
          <div class="bg-brand-gray-800 rounded-lg px-3 py-2">
            <div class="text-2xs text-brand-gray-500 uppercase tracking-wide mb-0.5">Moteur</div>
            <div class="text-xs font-medium text-brand-gray-200">{motor}</div>
          </div>
        )}
        {battery && (
          <div class="bg-brand-gray-800 rounded-lg px-3 py-2">
            <div class="text-2xs text-brand-gray-500 uppercase tracking-wide mb-0.5">Batterie</div>
            <div class="text-xs font-medium text-brand-gray-200">{battery}</div>
          </div>
        )}
        {autonomy && (
          <div class="bg-brand-gray-800 rounded-lg px-3 py-2">
            <div class="text-2xs text-brand-gray-500 uppercase tracking-wide mb-0.5">Autonomie</div>
            <div class="text-xs font-medium text-brand-gray-200">{autonomy}</div>
          </div>
        )}
        {weight && (
          <div class="bg-brand-gray-800 rounded-lg px-3 py-2">
            <div class="text-2xs text-brand-gray-500 uppercase tracking-wide mb-0.5">Poids</div>
            <div class="text-xs font-medium text-brand-gray-200">{weight}</div>
          </div>
        )}
      </div>
    )}

    <!-- Pros -->
    {pros.length > 0 && (
      <ul class="flex flex-col gap-1.5 mb-4" role="list">
        {pros.slice(0, 3).map(pro => (
          <li class="flex items-start gap-2 text-xs text-brand-gray-300">
            <svg class="w-3.5 h-3.5 text-brand-orange flex-shrink-0 mt-0.5" viewBox="0 0 14 14" fill="none" aria-hidden="true">
              <path d="M2.5 7L5.5 10L11.5 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
            {pro}
          </li>
        ))}
      </ul>
    )}

    <!-- Spacer -->
    <div class="flex-1"></div>

    <!-- Price + CTA -->
    <div class="mt-4 pt-4 border-t border-brand-gray-800">
      <div class="flex items-end justify-between gap-3">
        <div>
          {price ? (
            <div class="flex items-baseline gap-2">
              <span class="font-display font-bold text-xl text-brand-offwhite">
                {price.toLocaleString('fr-FR', { style: 'currency', currency: 'EUR', maximumFractionDigits: 0 })}
              </span>
              {priceOld && (
                <span class="text-sm text-brand-gray-500 line-through">
                  {priceOld.toLocaleString('fr-FR', { style: 'currency', currency: 'EUR', maximumFractionDigits: 0 })}
                </span>
              )}
            </div>
          ) : (
            <span class="text-sm text-brand-gray-400">Prix variable</span>
          )}
        </div>

        <a
          href={affiliateUrl}
          target="_blank"
          rel="noopener noreferrer nofollow"
          class="affiliate-cta flex-shrink-0"
          aria-label={`Voir ${brand} ${name} sur Amazon`}
          data-affiliate-product={name}
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M6.97 2h10.06A2 2 0 0119 3.94v13.44A2 2 0 0117.03 19H6.97A2 2 0 015 17.38V3.94A2 2 0 016.97 2zM12 14l5-3.5L12 7v3H7v2h5v2z"/>
          </svg>
          Voir sur Amazon
        </a>
      </div>
    </div>

  </div>
</article>

<script>
  // Track affiliate clicks
  document.querySelectorAll('[data-affiliate-product]').forEach(el => {
    el.addEventListener('click', () => {
      const product = (el as HTMLElement).dataset.affiliateProduct ?? '';
      if (typeof window !== 'undefined' && (window as any).gtag) {
        (window as any).gtag('event', 'affiliate_click', {
          product_name: product,
          click_source: 'product_card',
        });
      }
    });
  });
</script>
