---
import { amazonSearch } from '@utils/affiliate';

interface Props {
  variant?: 'amazon' | 'guide' | 'quiz';
}

const { variant = 'amazon' } = Astro.props;

const CONFIG = {
  amazon: {
    title:    'Les meilleures offres fatbike du moment',
    subtitle: 'Retrouve les modèles recommandés sur Amazon France. Livraison rapide, retours faciles.',
    cta:      'Voir les offres Amazon',
    href:     amazonSearch('fatbike électrique'),
    note:     'Lien affilié — nous percevons une commission sans surcoût pour toi',
    icon:     '🛒',
    external: true,
  },
  guide: {
    title:    'Top 10 Fatbikes Électriques 2026 — Notre sélection',
    subtitle: '50+ modèles analysés et comparés selon 12 critères. Notre sélection indépendante 2026.',
    cta:      'Voir le Top 10',
    href:     '/guide/top-10-fatbikes-2026/',
    note:     'Comparatif indépendant — aucun fabricant ne paie pour apparaître',
    icon:     '📖',
    external: false,
  },
  quiz: {
    title:    'Trouve le fatbike parfait en 2 minutes',
    subtitle: '4 questions simples. Une recommandation personnalisée parmi 50+ modèles.',
    cta:      'Faire le quiz gratuitement',
    href:     '/quiz/',
    note:     'Gratuit · Sans inscription · Résultat immédiat',
    icon:     '🎯',
    external: false,
  },
};

const conf = CONFIG[variant];
---

<div class="relative overflow-hidden rounded-3xl" aria-label={conf.title}>

  <!-- Background -->
  <div class="absolute inset-0" aria-hidden="true">
    <div class="absolute inset-0 bg-gradient-to-br from-brand-gray-800 via-brand-gray-900 to-brand-black"></div>
    <!-- Orange glow -->
    <div class="absolute top-0 right-0 w-80 h-80 bg-brand-orange/15 rounded-full blur-3xl translate-x-1/3 -translate-y-1/3"></div>
    <div class="absolute bottom-0 left-0 w-60 h-60 bg-brand-orange/8 rounded-full blur-3xl -translate-x-1/3 translate-y-1/3"></div>
    <!-- Border glow -->
    <div class="absolute inset-0 border border-brand-orange/20 rounded-3xl"></div>
  </div>

  <div class="relative z-10 p-7 md:p-10">
    <div class="flex flex-col md:flex-row items-start md:items-center gap-6 md:gap-10">

      <!-- Icon -->
      <div class="flex-shrink-0 w-14 h-14 rounded-2xl bg-brand-orange/15 border border-brand-orange/25
                  flex items-center justify-center text-2xl" aria-hidden="true">
        {conf.icon}
      </div>

      <!-- Copy -->
      <div class="flex-1">
        <h3 class="font-display font-bold text-brand-offwhite text-xl md:text-2xl mb-2 leading-tight">
          {conf.title}
        </h3>
        <p class="text-brand-gray-300 text-sm md:text-base leading-relaxed">
          {conf.subtitle}
        </p>
      </div>

      <!-- CTA -->
      <div class="flex flex-col items-start md:items-end gap-2 flex-shrink-0">
        <a
          href={conf.href}
          target={conf.external ? '_blank' : undefined}
          rel={conf.external ? 'noopener noreferrer nofollow' : undefined}
          class:list={[
            'btn-lg font-semibold whitespace-nowrap',
            variant === 'amazon' ? 'affiliate-cta' : 'btn-primary',
          ]}
          aria-label={conf.cta}
        >
          {conf.external && (
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M6.97 2h10.06A2 2 0 0119 3.94v13.44A2 2 0 0117.03 19H6.97A2 2 0 015 17.38V3.94A2 2 0 016.97 2z"/>
            </svg>
          )}
          {conf.cta}
          {!conf.external && (
            <svg class="w-5 h-5" viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <path d="M4 10h12M11 5l5 5-5 5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
            </svg>
          )}
        </a>
        <p class="text-xs text-brand-gray-500">{conf.note}</p>
      </div>

    </div>
  </div>
</div>
