---
import { SITE, buildTitle, buildCanonical, buildOGImage, buildWebsiteSchema, type SEOProps } from '@utils/seo';

interface Props extends SEOProps { schema?: object | object[] }
const { title, description = SITE.description, ogImage, ogImageAlt, canonicalUrl, noIndex = false, type = 'website', pubDate, updatedDate, schema } = Astro.props;

const pageTitle = buildTitle(title);
const canonical = canonicalUrl ?? buildCanonical(Astro.url.pathname);
const og = buildOGImage(ogImage);
const schemas = [buildWebsiteSchema(), ...(schema ? (Array.isArray(schema) ? schema : [schema]) : [])];
---
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{pageTitle}</title>
<meta name="description" content={description} />
<meta name="robots" content={noIndex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1'} />
<link rel="canonical" href={canonical} />
<meta name="theme-color" content="#161616" />
<meta name="p:domain_verify" content="1b1de15e15d0d7480990bd904e766f82" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="icon" href="/favicon-32.png" sizes="32x32" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

<meta property="og:type" content={type} />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={og} />
<meta property="og:image:alt" content={ogImageAlt ?? pageTitle} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content={SITE.locale} />
{type === 'article' && pubDate && <meta property="article:published_time" content={pubDate.toISOString()} />}
{type === 'article' && updatedDate && <meta property="article:modified_time" content={updatedDate.toISOString()} />}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:image" content={og} />

{schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
