---
import type { Bike } from '@data/bikes';
import { euro } from '@data/bikes';
import { AFF_REL } from '@utils/affiliate';
interface Props { bikes: Bike[] }
const { bikes } = Astro.props;
---
<div class="card my-8 overflow-x-auto">
  <table class="table-clean min-w-[720px]">
    <thead><tr><th>Modèle</th><th>Pour qui</th><th>Roues</th><th>Poids</th><th>Dès</th><th></th></tr></thead>
    <tbody>
      {bikes.map((b) => (
        <tr>
          <td><a href={`#${b.id}`} class="font-bold text-ink hover:text-orange-dark">{b.name}</a>{b.tested && <span class="ml-1 text-xs text-orange-dark">★</span>}</td>
          <td class="text-ink-soft">{b.bestFor}</td>
          <td class="whitespace-nowrap">{b.wheels}</td>
          <td class="whitespace-nowrap">{b.weight.replace('env. ', '')}</td>
          <td class="whitespace-nowrap font-bold">{euro(b.priceFrom)}</td>
          <td><a href={b.href} rel={AFF_REL} target="_blank" data-product={b.id} class="whitespace-nowrap font-bold text-orange-dark hover:underline">Prix →</a></td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
