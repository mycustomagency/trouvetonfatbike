---
// In production, these will be fetched from Astro content collections:
// const guides = await getCollection('guides', ({ data }) => data.featured);

const GUIDES = [
  {
    title:       'Meilleur fatbike électrique 2026 : le comparatif complet',
    excerpt:     'Nous avons testé plus de 50 modèles pour te proposer le classement définitif, du petit budget au haut de gamme. Moteurs, batteries, autonomie, prix : tout est comparé.',
    category:    'Comparatif',
    href:        '/guide/meilleur-fatbike-electrique-2026/',
    readingTime: 18,
    featured:    true,
    image:       'https://images.unsplash.com/photo-1571068316344-75bc76f77890?w=700&q=75',
    date:        'Mis à jour 2026',
  },
  {
    title:       'Guide d\'achat fatbike : tout savoir avant de choisir',
    excerpt:     'Moteur, batterie, pneus, cadre, freins : le guide complet pour comprendre toutes les caractéristiques techniques et ne pas se tromper lors de l\'achat.',
    category:    'Guide d\'achat',
    href:        '/guide/guide-achat-fatbike/',
    readingTime: 14,
    featured:    false,
    image:       null,
    date:        'Mis à jour 2026',
  },
  {
    title:       'Autonomie fatbike : comment optimiser ta batterie',
    excerpt:     'Facteurs clés, modes d\'assistance, entretien et astuces terrain pour repousser les limites de ta batterie et ne jamais tomber en rade.',
    category:    'Technique',
    href:        '/guide/autonomie-batterie-fatbike/',
    readingTime: 10,
    featured:    false,
    image:       null,
    date:        'Mis à jour 2026',
  },
];
---

<section class="section-padding" aria-labelledby="guides-heading">
  <div class="container-site">

    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12 reveal">
      <div>
        <div class="section-label mb-4">Guides & Conseils</div>
        <h2 id="guides-heading" class="heading-h2">
          Nos derniers guides
        </h2>
      </div>
      <a href="/guide/" class="btn-ghost btn-md flex-shrink-0">
        Tous les guides →
      </a>
    </div>

    <!-- Articles grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

      <!-- Featured article (large) -->
      {GUIDES.filter(g => g.featured).map(guide => (
        <article class="lg:col-span-2 card-base card-hover group overflow-hidden reveal">
          <a href={guide.href} class="flex flex-col h-full no-underline">
            <!-- Image -->
            {guide.image && (
              <div class="relative h-56 md:h-72 overflow-hidden bg-brand-gray-800 flex-shrink-0">
                <img
                  src={guide.image}
                  alt={guide.title}
                  class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                  loading="lazy"
                  decoding="async"
                  width="700"
                  height="400"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-brand-gray-900/70 to-transparent"></div>
                <div class="absolute bottom-4 left-4">
                  <span class="badge-orange badge border border-brand-orange/25">
                    ⭐ Article phare
                  </span>
                </div>
              </div>
            )}

            <!-- Content -->
            <div class="flex flex-col flex-1 p-6 md:p-7">
              <div class="flex items-center gap-3 mb-3">
                <span class="badge-gray badge">{guide.category}</span>
                <span class="text-xs text-brand-gray-500">{guide.date}</span>
                <span class="text-xs text-brand-gray-500">· {guide.readingTime} min de lecture</span>
              </div>
              <h3 class="font-display font-bold text-brand-offwhite text-xl mb-3 leading-snug
                         group-hover:text-brand-orange transition-colors duration-200">
                {guide.title}
              </h3>
              <p class="text-brand-gray-300 text-sm leading-relaxed flex-1 line-clamp-3">
                {guide.excerpt}
              </p>
              <div class="flex items-center gap-2 mt-5 text-sm text-brand-orange font-medium
                          group-hover:gap-3 transition-all duration-200">
                Lire l'article
                <svg class="w-4 h-4" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </div>
            </div>
          </a>
        </article>
      ))}

      <!-- Regular articles (stacked) -->
      <div class="flex flex-col gap-5">
        {GUIDES.filter(g => !g.featured).map((guide, i) => (
          <article class="card-base card-hover group overflow-hidden reveal" style={`animation-delay: ${(i + 1) * 0.1}s`}>
            <a href={guide.href} class="flex flex-col p-5 no-underline">
              <div class="flex items-center gap-2 mb-2.5">
                <span class="badge-gray badge">{guide.category}</span>
                <span class="text-2xs text-brand-gray-500">{guide.readingTime} min</span>
              </div>
              <h3 class="font-display font-semibold text-brand-offwhite text-sm leading-snug mb-2.5
                         group-hover:text-brand-orange transition-colors duration-200 line-clamp-2">
                {guide.title}
              </h3>
              <p class="text-xs text-brand-gray-400 leading-relaxed line-clamp-2 mb-4">
                {guide.excerpt}
              </p>
              <div class="flex items-center justify-between">
                <span class="text-xs text-brand-gray-500">{guide.date}</span>
                <span class="text-xs text-brand-orange flex items-center gap-1 font-medium">
                  Lire
                  <svg class="w-3 h-3" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                    <path d="M2 6h8M7 3l3 3-3 3" stroke="currentColor" stroke-width="1.25" stroke-linecap="round"/>
                  </svg>
                </span>
              </div>
            </a>
          </article>
        ))}
      </div>

    </div>
  </div>
</section>
