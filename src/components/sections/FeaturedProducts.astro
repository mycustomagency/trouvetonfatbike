---
import ProductCard from '@components/product/ProductCard.astro';
import { BIKES } from '@data/bikes';

interface Props {
  title?: string;
  subtitle?: string;
}

const {
  title    = 'Les meilleurs fatbikes du moment',
  subtitle = 'Sélection 2026 — testés, comparés et recommandés par notre équipe.',
} = Astro.props;

type BadgeType = 'best' | 'deal' | 'new' | 'editor' | 'budget';

const featuredBikes = BIKES.slice(0, 3);
const gridBikes     = BIKES.slice(3);
---

<section class="section-padding" aria-labelledby="featured-heading">
  <div class="container-site">

    <!-- ─── Header ──────────────────────────────────────────────── -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12 reveal">
      <div>
        <div class="section-label mb-4">Sélection de la rédaction</div>
        <h2 id="featured-heading" class="heading-h2 text-balance">{title}</h2>
        <p class="text-brand-gray-300 mt-3 max-w-lg text-pretty">{subtitle}</p>
      </div>
      <a href="/guide/meilleur-fatbike-electrique-2026/" class="btn-ghost btn-md flex-shrink-0">
        Comparatif complet 2026 →
      </a>
    </div>

    <!-- ─── Top 3 featured ──────────────────────────────────────── -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-10">
      {featuredBikes.map((bike, i) => (
        <div class="reveal" style={`animation-delay: ${i * 0.12}s`}>
          <ProductCard
            name={bike.name}
            brand={bike.brand}
            asin={bike.asin}
            price={bike.price}
            image={bike.image}
            motor={bike.motor}
            battery={bike.battery}
            autonomy={bike.autonomy}
            weight={bike.weight}
            badge={bike.badge || undefined}
            badgeType={bike.badgeType as BadgeType}
            pros={bike.pros}
            rating={bike.rating}
            reviewCount={bike.reviewCount}
          />
        </div>
      ))}
    </div>

    <!-- ─── Séparateur "Voir aussi" ─────────────────────────────── -->
    <div class="flex items-center gap-4 mb-8 reveal">
      <div class="flex-1 h-px bg-brand-gray-800"></div>
      <span class="text-xs font-semibold text-brand-gray-400 uppercase tracking-widest whitespace-nowrap">
        Voir aussi
      </span>
      <div class="flex-1 h-px bg-brand-gray-800"></div>
    </div>

    <!-- ─── Grille secondaire ───────────────────────────────────── -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 mb-12">
      {gridBikes.map((bike, i) => (
        <div class="reveal" style={`animation-delay: ${i * 0.08}s`}>
          <ProductCard
            name={bike.name}
            brand={bike.brand}
            asin={bike.asin}
            price={bike.price}
            image={bike.image}
            motor={bike.motor}
            battery={bike.battery}
            autonomy={bike.autonomy}
            weight={bike.weight}
            badge={bike.badge || undefined}
            badgeType={bike.badgeType as BadgeType}
            pros={bike.pros}
            rating={bike.rating}
            reviewCount={bike.reviewCount}
          />
        </div>
      ))}
    </div>

    <!-- ─── Bottom CTA ──────────────────────────────────────────── -->
    <div class="text-center reveal">
      <div class="inline-flex flex-col sm:flex-row items-center gap-4 p-6 card-glass rounded-2xl">
        <div class="text-left">
          <p class="text-sm font-medium text-brand-offwhite">Pas sûr de ton choix ?</p>
          <p class="text-xs text-brand-gray-400">Notre quiz te guide en 2 minutes</p>
        </div>
        <a href="/quiz/" class="btn-primary btn-md flex-shrink-0 whitespace-nowrap">
          Faire le quiz →
        </a>
      </div>
    </div>

  </div>
</section>
