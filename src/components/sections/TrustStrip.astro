---
const STATS = [
  { value: '50+',    label: 'Fatbikes analysés & comparés', icon: '🔬' },
  { value: '12',     label: 'Catégories d\'usage couvertes', icon: '📂' },
  { value: '2026',   label: 'Guides mis à jour',             icon: '📅' },
  { value: '100%',   label: 'Avis indépendants',             icon: '✅' },
  { value: 'Gratuit',label: 'Quiz & guides sans inscription',icon: '🎯' },
  { value: 'SEO',    label: 'Sélection orientée terrain',    icon: '🗺️' },
];
---

<div class="bg-brand-gray-900 border-y border-brand-gray-800 py-10 overflow-hidden" aria-label="Notre approche">
  <div class="container-site">
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-6">
      {STATS.map((s, i) => (
        <div
          class="flex flex-col items-center text-center gap-1.5 reveal"
          style={`animation-delay: ${i * 0.06}s`}
        >
          <span class="text-2xl mb-1" aria-hidden="true">{s.icon}</span>
          <span class="font-display font-bold text-2xl text-brand-offwhite">{s.value}</span>
          <span class="text-xs text-brand-gray-400 leading-snug">{s.label}</span>
        </div>
      ))}
    </div>
  </div>
</div>
