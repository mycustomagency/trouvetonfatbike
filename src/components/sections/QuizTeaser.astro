---
const QUIZ_STEPS = [
  { q: 'Quel est ton budget ?',      options: ['< 800€', '800–2000€', '2000–4000€', '4000€+'] },
  { q: 'Ton terrain principal ?',    options: ['Montagne', 'Plage', 'Ville', 'Mixte'] },
  { q: 'Ton niveau d\'expérience ?', options: ['Débutant', 'Intermédiaire', 'Expert'] },
  { q: 'L\'autonomie voulue ?',      options: ['< 50 km', '50–80 km', '80–120 km', '120 km+'] },
];
---

<section
  class="section-padding relative overflow-hidden"
  aria-labelledby="quiz-heading"
  style="background: linear-gradient(135deg, #111111 0%, #1a1a1a 50%, #111111 100%);"
>

  <!-- Decorative elements -->
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <!-- Orange radial glow -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2
                w-[700px] h-[400px] bg-brand-orange/8 rounded-full blur-3xl"></div>
    <!-- Grid pattern -->
    <div class="absolute inset-0 opacity-[0.025]"
         style="background-image: radial-gradient(circle, #888 1px, transparent 1px); background-size: 28px 28px;"></div>
  </div>

  <div class="container-site relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-24 items-center">

      <!-- ─── Left: copy ──────────────────────────────────────────── -->
      <div class="reveal">
        <div class="section-label mb-5">Personnalise ton choix</div>
        <h2 id="quiz-heading" class="heading-h2 mb-5 text-balance">
          Quel fatbike est<br/>
          <span class="text-gradient-orange">fait pour toi ?</span>
        </h2>
        <p class="text-brand-gray-300 text-lg leading-relaxed mb-8 text-pretty">
          En 4 questions, notre outil de recommandation identifie les fatbikes parfaitement adaptés à ton usage, ton terrain et ton budget.
        </p>

        <!-- Benefits list -->
        <ul class="flex flex-col gap-3 mb-10" role="list">
          {[
            'Sélection personnalisée parmi 50+ modèles',
            'Comparatif adapté à ton budget réel',
            'Recommandations d\'experts vérifiées',
            'Résultat immédiat, sans inscription',
          ].map(item => (
            <li class="flex items-center gap-3 text-sm text-brand-gray-200">
              <svg class="w-4 h-4 text-brand-orange flex-shrink-0" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <circle cx="8" cy="8" r="7" stroke="currentColor" stroke-width="1.25"/>
                <path d="M5 8l2 2 4-4" stroke="currentColor" stroke-width="1.25" stroke-linecap="round"/>
              </svg>
              {item}
            </li>
          ))}
        </ul>

        <a href="/quiz/" class="btn-primary btn-lg group inline-flex">
          Lancer le quiz gratuitement
          <svg class="w-5 h-5 transition-transform duration-300 group-hover:translate-x-1"
               viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M4 10h12M11 5l5 5-5 5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
        <p class="text-xs text-brand-gray-500 mt-3">2 minutes • Gratuit • Sans inscription</p>
      </div>

      <!-- ─── Right: quiz preview card ────────────────────────────── -->
      <div class="reveal reveal-delay-2">
        <div class="card-glass p-6 md:p-8 relative">

          <!-- Progress bar -->
          <div class="flex items-center gap-3 mb-6">
            <div class="flex-1 h-1.5 bg-brand-gray-700 rounded-full overflow-hidden">
              <div class="h-full bg-brand-orange rounded-full" style="width: 25%"></div>
            </div>
            <span class="text-xs text-brand-gray-400 flex-shrink-0">1 / 4</span>
          </div>

          <!-- Question -->
          <div id="quiz-preview" class="min-h-[260px] flex flex-col">
            <p class="text-xs text-brand-orange uppercase tracking-widest font-medium mb-3">
              Question 1
            </p>
            <h3 class="font-display font-semibold text-brand-offwhite text-xl mb-6" id="quiz-q">
              {QUIZ_STEPS[0].q}
            </h3>

            <!-- Options -->
            <div class="grid grid-cols-2 gap-3 flex-1" id="quiz-options">
              {QUIZ_STEPS[0].options.map((opt, i) => (
                <button
                  class="quiz-opt group px-4 py-3.5 rounded-xl border border-brand-gray-700
                         bg-brand-gray-800/50 text-sm text-brand-gray-200
                         hover:border-brand-orange hover:bg-brand-orange/10 hover:text-brand-orange
                         transition-all duration-200 text-left font-medium"
                  data-index={i}
                  aria-label={`Répondre : ${opt}`}
                >
                  {opt}
                </button>
              ))}
            </div>
          </div>

          <!-- Bottom -->
          <div class="mt-6 pt-5 border-t border-white/10 flex items-center justify-between">
            <p class="text-xs text-brand-gray-500">
              Quiz interactif complet sur la page dédiée
            </p>
            <a href="/quiz/" class="text-xs text-brand-orange hover:underline font-medium">
              Ouvrir →
            </a>
          </div>

          <!-- Floating label -->
          <div class="absolute -top-3 -right-3 badge-orange badge border shadow-orange-sm">
            Gratuit
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<script>
  // ─── Quiz preview animation ──────────────────────────────────────────────
  const STEPS = [
    { q: 'Quel est ton budget ?',      options: ['< 800€', '800–2000€', '2000–4000€', '4000€+'] },
    { q: 'Ton terrain principal ?',    options: ['Montagne', 'Plage', 'Ville', 'Mixte'] },
    { q: "Ton niveau d'expérience ?",  options: ['Débutant', 'Intermédiaire', 'Expert', 'Peu importe'] },
    { q: "L'autonomie voulue ?",       options: ['< 50 km', '50–80 km', '80–120 km', '120 km+'] },
  ];

  let currentStep = 0;
  const qEl      = document.getElementById('quiz-q');
  const optsEl   = document.getElementById('quiz-options');

  function renderStep(step: number) {
    if (!qEl || !optsEl) return;
    const s = STEPS[step];

    // Update progress
    const bar = document.querySelector('#quiz-preview ~ div .bg-brand-orange') as HTMLElement | null;
    const label = document.querySelector('#quiz-preview ~ div .text-xs.text-brand-gray-400') as HTMLElement | null;
    if (bar) bar.style.width = `${((step + 1) / STEPS.length) * 100}%`;
    if (label) label.textContent = `${step + 1} / ${STEPS.length}`;

    // Fade out
    qEl.style.opacity = '0';
    optsEl.style.opacity = '0';
    qEl.style.transform = 'translateY(8px)';

    setTimeout(() => {
      if (!qEl || !optsEl) return;
      qEl.textContent = s.q;
      optsEl.innerHTML = s.options.map((opt, i) => `
        <button
          class="quiz-opt px-4 py-3.5 rounded-xl border border-brand-gray-700
                 bg-brand-gray-800/50 text-sm text-brand-gray-200
                 hover:border-brand-orange hover:bg-brand-orange/10 hover:text-brand-orange
                 transition-all duration-200 text-left font-medium"
          data-index="${i}"
        >${opt}</button>
      `).join('');

      // Re-bind events
      bindOptions();

      // Fade in
      qEl.style.opacity = '1';
      optsEl.style.opacity = '1';
      qEl.style.transform = 'translateY(0)';
    }, 200);
  }

  function bindOptions() {
    document.querySelectorAll('.quiz-opt').forEach(btn => {
      btn.addEventListener('click', () => {
        // Visual feedback
        btn.classList.add('border-brand-orange', 'bg-brand-orange/20', 'text-brand-orange');

        setTimeout(() => {
          currentStep = (currentStep + 1) % STEPS.length;
          renderStep(currentStep);
        }, 400);
      }, { once: true });
    });
  }

  // Add transitions to q
  if (qEl) {
    qEl.style.transition = 'opacity 0.2s ease, transform 0.2s ease';
  }
  if (optsEl) {
    optsEl.style.transition = 'opacity 0.2s ease';
  }

  bindOptions();
</script>
