---
const QUIZ_QUESTIONS = [
  { emoji: '🚴', label: 'Niveau d\'expérience', hint: 'Débutant → Expert' },
  { emoji: '⛰️', label: 'Terrain principal',   hint: 'Montagne, plage, ville…' },
  { emoji: '💰', label: 'Budget',               hint: '< 800€ → 4000€+' },
  { emoji: '⚡', label: 'Autonomie voulue',     hint: '< 50 km → 120 km+' },
];
---

<section
  class="section-padding relative overflow-hidden"
  aria-labelledby="quiz-heading"
  style="background: linear-gradient(135deg, #111111 0%, #1a1a1a 50%, #111111 100%);"
>

  <!-- Decorative background -->
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2
                w-[700px] h-[400px] bg-brand-orange/8 rounded-full blur-3xl"></div>
    <div class="absolute inset-0 opacity-[0.025]"
         style="background-image: radial-gradient(circle, #888 1px, transparent 1px); background-size: 28px 28px;"></div>
  </div>

  <div class="container-site relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-24 items-center">

      <!-- ─── Left: copy ──────────────────────────────────────────── -->
      <div class="reveal">
        <div class="section-label mb-5">Personnalise ton choix</div>
        <h2 id="quiz-heading" class="heading-h2 mb-5 text-balance">
          Quel fatbike est<br/>
          <span class="text-gradient-orange">fait pour toi ?</span>
        </h2>
        <p class="text-brand-gray-300 text-lg leading-relaxed mb-8 text-pretty">
          En 4 questions, notre outil de recommandation identifie les fatbikes parfaitement adaptés à ton usage, ton terrain et ton budget.
        </p>

        <!-- Benefits list -->
        <ul class="flex flex-col gap-3 mb-10" role="list">
          {[
            'Sélection personnalisée parmi 50+ modèles',
            'Comparatif adapté à ton budget réel',
            'Recommandations d\'experts vérifiées',
            'Résultat immédiat, sans inscription',
          ].map(item => (
            <li class="flex items-center gap-3 text-sm text-brand-gray-200">
              <svg class="w-4 h-4 text-brand-orange flex-shrink-0" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <circle cx="8" cy="8" r="7" stroke="currentColor" stroke-width="1.25"/>
                <path d="M5 8l2 2 4-4" stroke="currentColor" stroke-width="1.25" stroke-linecap="round"/>
              </svg>
              {item}
            </li>
          ))}
        </ul>

        <a href="/quiz/" class="btn-primary btn-lg group inline-flex">
          Lancer le quiz gratuitement
          <svg class="w-5 h-5 transition-transform duration-300 group-hover:translate-x-1"
               viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M4 10h12M11 5l5 5-5 5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
        <p class="text-xs text-brand-gray-500 mt-3">2 minutes • Gratuit • Sans inscription</p>
      </div>

      <!-- ─── Right: static quiz card ─────────────────────────────── -->
      <div class="reveal reveal-delay-2">
        <div class="card-glass p-6 md:p-8 relative">

          <!-- Header -->
          <div class="flex items-center justify-between mb-6">
            <div>
              <p class="text-xs text-brand-orange uppercase tracking-widest font-medium mb-1">Quiz personnalisé</p>
              <h3 class="font-display font-bold text-brand-offwhite text-lg">4 questions pour trouver ton vélo</h3>
            </div>
            <div class="w-10 h-10 rounded-xl bg-brand-orange/15 flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5 text-brand-orange" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                <path d="M9 2a1 1 0 000 2h2a1 1 0 100-2H9z" fill="currentColor"/>
                <path fill-rule="evenodd" d="M4 5a2 2 0 012-2 3 3 0 003 3h2a3 3 0 003-3 2 2 0 012 2v11a2 2 0 01-2 2H6a2 2 0 01-2-2V5zm3 4a1 1 0 000 2h.01a1 1 0 100-2H7zm3 0a1 1 0 000 2h3a1 1 0 100-2h-3zm-3 4a1 1 0 100 2h.01a1 1 0 100-2H7zm3 0a1 1 0 100 2h3a1 1 0 100-2h-3z" fill-rule="evenodd" fill="currentColor"/>
              </svg>
            </div>
          </div>

          <!-- Questions list -->
          <ul class="flex flex-col gap-3 mb-7" role="list">
            {QUIZ_QUESTIONS.map((q, i) => (
              <li class="flex items-center gap-4 p-3.5 rounded-xl bg-brand-gray-800/60 border border-brand-gray-700/60">
                <span class="text-2xl flex-shrink-0 w-9 text-center" aria-hidden="true">{q.emoji}</span>
                <div class="flex-1 min-w-0">
                  <p class="text-sm font-semibold text-brand-gray-100">{q.label}</p>
                  <p class="text-xs text-brand-gray-400 mt-0.5">{q.hint}</p>
                </div>
                <span class="text-xs font-bold text-brand-orange/60 flex-shrink-0">Q{i + 1}</span>
              </li>
            ))}
          </ul>

          <!-- CTA button -->
          <a
            href="/quiz/"
            class="btn-primary btn-md w-full justify-center group"
          >
            Faire le quiz →
          </a>

          <!-- Bottom note -->
          <p class="text-xs text-brand-gray-500 text-center mt-3">2 minutes • Résultat immédiat</p>

          <!-- Floating badge -->
          <div class="absolute -top-3 -right-3 badge-orange badge border shadow-orange-sm">
            Gratuit
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
